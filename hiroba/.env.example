# ひろば 環境変数サンプル
# .env にコピーして値を設定してください（縁側の .env とは完全に独立しています）

# セッション署名用シークレットキー
HIROBA_SECRET_KEY=change-me-to-a-random-secret

# データベース接続URL（未設定時は SQLite: hiroba.db を使用）
HIROBA_DATABASE_URL=sqlite:///./hiroba.db

# OpenAI APIキー（ボイスメモのWhisper音声認識に使用）
OPENAI_API_KEY=

# このアプリの公開URL（末尾スラッシュなし。OAuthコールバックURL生成に使用）
# 例: 本番 https://hiroba.example.com / ローカル http://localhost:8000
BASE_URL=http://localhost:8000

# --- LINEログイン（LINE Developers コンソールで発行） ---
# コールバックURLとして "{BASE_URL}/auth/line/callback" を登録してください
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# --- LINE Messaging API（保護者への通知送信専用。ログイン用チャネルとは別） ---
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=

# --- Googleログイン（Google Cloud Console の OAuth 2.0 クライアント） ---
# コールバックURLとして "{BASE_URL}/auth/google/callback" を登録してください
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
