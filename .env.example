# 縁側（えんがわ） 環境変数サンプル
# このファイルを .env にコピーして値を設定してください（.envはgit管理対象外）

# セッション署名用の秘密鍵（本番では必ずランダムな値に変更してください）
SECRET_KEY=engawa-dev-secret-key-change-me

# データベース接続先（未設定ならSQLiteを使用）
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- AIおしゃべり機能（OpenAI） ---
# 設定すると /talk 画面で実際にAIと会話できるようになります
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- SMS認証（Twilio） ---
# すべて設定すると本物のSMSを送信します。未設定の場合は開発モード（画面にコード表示）で動作します
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
